{
  "name": "farosatxona-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Farosatxona — Telegram guruhlari uchun kulgili kunlik farosat boti",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "node src/preview.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --test"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "railway": "^3.12.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
